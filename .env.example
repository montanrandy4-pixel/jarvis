# JARVIS runs a model on your own machine by default and needs no API key.
# Everything below is optional; defaults are shown.

# --- Model ---
# JARVIS_BACKEND=ollama          # ollama | openai (any OpenAI-compatible server)
# JARVIS_MODEL=llama3.1:8b       # must support tool calling
# JARVIS_BASE_URL=               # default: http://localhost:11434 (ollama)
#                                #          http://localhost:8080/v1 (openai)
# JARVIS_API_KEY_ENV=OPENAI_API_KEY   # env var holding the key, if one is needed
# JARVIS_TEMPERATURE=0.6
# JARVIS_CONTEXT_TOKENS=8192
# JARVIS_MAX_REPLY_TOKENS=1024   # replies are spoken aloud, so keep them short
# JARVIS_KEEP_ALIVE=10m          # how long ollama keeps the model in memory

# --- App ---
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8765
# JARVIS_OPEN_BROWSER=true

# --- Tools ---
# JARVIS_SHELL=confirm           # off | confirm | on
# JARVIS_ALLOW_WEB=true          # web search and page reading
# JARVIS_WORKSPACE=              # colon-separated dirs the file tools may touch

# --- Persona ---
# JARVIS_NAME=JARVIS
# JARVIS_ADDRESS_USER_AS=sir
# JARVIS_USER_NAME=

# --- Terminal voice mode (jarvis listen) ---
# JARVIS_WAKE_WORD=hey jarvis
# JARVIS_STT_MODEL=base.en
# JARVIS_TTS_BACKEND=auto        # auto | piper | pyttsx3 | say | espeak | none
# JARVIS_VOICE_NAME=

# --- Storage ---
# JARVIS_STATE_DIR=~/.local/state/jarvis
