# Required: your Anthropic API key (https://console.anthropic.com/settings/keys).
# If you have run `ant auth login`, you can leave this unset -- the SDK picks up
# the stored profile automatically.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=low              # low|medium|high|xhigh|max -- low keeps replies snappy
# JARVIS_WAKE_WORD=hey jarvis
# JARVIS_VOICE_NAME=              # backend-specific voice id, e.g. a piper .onnx path
# JARVIS_STT_MODEL=base.en        # faster-whisper model size
# JARVIS_TTS_BACKEND=auto         # auto|piper|pyttsx3|say|espeak|none
# JARVIS_SHELL=confirm            # off|confirm|on -- how the shell tool is gated
# JARVIS_STATE_DIR=~/.local/state/jarvis
