# ---- Shopify -----------------------------------------------------------
# Either "my-store" or "my-store.myshopify.com" -- both work.
SHOP_NAME=my-store

# Admin API access token from a custom app:
#   Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Admin API scopes, then Install.
# Scopes needed: read_products, read_inventory, read_orders
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01

# ---- Agent -------------------------------------------------------------
# How often to check the store, in minutes.
AGENT_INTERVAL_MINUTES=30
AGENT_RUN_ON_START=true

# One info-level "here is your day" alert per day. Set false to switch it off.
AGENT_DAILY_SUMMARY=true

# ---- What counts as worth knowing --------------------------------------
LOW_STOCK_THRESHOLD=5
HIGH_VALUE_ORDER=250
REFUND_RATE_THRESHOLD=10
SALES_DROP_THRESHOLD=40
ORDER_LOOKBACK_DAYS=7

# ---- Local -------------------------------------------------------------
PORT=3000
DATABASE_FILE=database/shopkeeper.db
